# Production Environment Template for vicecodesdb.com (cPanel)
# Copy this file to .env on your server (never commit .env to GitHub)

APP_ENV=production
APP_DEBUG=false
APP_URL=https://vicecodesdb.com
BASE_PATH=

DB_HOST=localhost

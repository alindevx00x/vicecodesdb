Options -Indexes

# Block direct access to sensitive folders & dotfiles when deployed inside cPanel public_html/
<FilesMatch "^\.(env|htaccess|git|cpanel)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "\.(sql|md|log|yml|yaml|sh|ini|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Allow cPanel AutoSSL / Let's Encrypt domain validation
    RewriteRule ^\.well-known/ - [L]

    # Block direct HTTP access to hidden files/folders (.git, .env, etc.)
    RewriteRule (^|/)\.(?!well-known) - [F,L]

    # Block direct HTTP access to internal PHP/DB/storage directories
    RewriteRule ^(app|bin|config|database|storage|views)(/|$) - [F,L]

    # Route all requests cleanly into /public/
    RewriteRule ^$ public/index.php [L]
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
